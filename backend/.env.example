# ==============================================================================
# MediFind Connect Backend — Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development.
# In production (Render), add these variables in the Render Dashboard environment settings.
# NEVER commit real credentials or .env to version control.
# ==============================================================================

# Server Runtime Configuration
# Set to 'production' on Render; defaults to 'development' locally
NODE_ENV=development

# Server Port
# Render assigns PORT dynamically (default 10000 on Render; 5000 locally)
PORT=5000

# Client Allowed Origins for CORS (comma-separated for multiple origins)
# In production, include your Vercel frontend URL, e.g.:
# FRONTEND_ORIGIN=https://medifind-connect.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# Supabase PostgreSQL & Auth Credentials
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
