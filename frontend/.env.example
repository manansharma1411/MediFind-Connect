# ==============================================================================
# MediFind Connect Frontend — Environment Variables Example
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real credentials.
# ==============================================================================

# Base URL for Person B's Backend API (set to the live Render URL in Vercel)
NEXT_PUBLIC_API_BASE_URL=https://your-backend-url.example.com

# Public Supabase Auth configuration (NEVER place SUPABASE_SERVICE_ROLE_KEY here)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
